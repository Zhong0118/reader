<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="neoReadCiteTab" label="NeoRead">
        <group id="neoReadCiteGroup" label="引用">
          <button id="addEditCitation" label="添加/编辑引注" size="large" imageMso="CitationInsert" onAction="NeoReadCiteAction" screentip="添加/编辑引注" supertip="在光标处插入引注，或编辑光标所在的引注"/>
          <button id="addEditBibliography" label="插入参考文献表" size="large" imageMso="BibliographyGallery" onAction="NeoReadCiteAction" screentip="插入参考文献表" supertip="在光标处插入参考文献表，或更新已有的参考文献表"/>
          <button id="refresh" label="刷新" size="large" imageMso="Refresh" onAction="NeoReadCiteAction" screentip="刷新" supertip="按论文库中的最新信息更新全部引注和参考文献表"/>
          <button id="setDocPrefs" label="文档首选项" imageMso="PropertySheet" onAction="NeoReadCiteAction" screentip="文档首选项" supertip="选择引用样式、语言和脚注方式"/>
          <button id="removeCodes" label="取消链接" imageMso="HyperlinkRemove" onAction="NeoReadCiteAction" screentip="取消链接" supertip="把引注和参考文献表变成普通文字，之后不能再更新"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
